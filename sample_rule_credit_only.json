{
  "name": "Instrument Credit Reversal — CREDIT only",
  "description": "Post a standalone credit reversal entry for instrument balances. The credit account is fixed to a central suspense account; all other dimensions follow the source. No debit entry is generated.",
  "source_table": "proc_inst_data",
  "lookup_table": "ref_static_allocation",
  "output_table": "fct_mgmt_instrument",
  "join_key": "customer_id",
  "entry_mode": "CREDIT_ONLY",
  "filter_json": {
    "logic": "AND",
    "conditions": [
      {
        "field": "product_code",
        "operator": "eq",
        "value": "LOAN"
      }
    ]
  },
  "source_dim_json": {
    "account_id":   { "mode": "all" },
    "customer_id":  { "mode": "all" },
    "product_code": { "mode": "specific", "members": ["LOAN"] },
    "org_unit_id":  { "mode": "all" }
  },
  "output_dim_json": {},
  "credit_dim_json": {
    "account_id":   { "mode": "fixed", "value": "SUSP-CR-001" },
    "customer_id":  { "mode": "same_as_source" },
    "product_code": { "mode": "same_as_source" },
    "org_unit_id":  { "mode": "lookup", "lookup_column": "target_org_unit_id" }
  }
}
