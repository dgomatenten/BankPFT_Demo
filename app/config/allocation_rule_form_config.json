{
    "description": "Drives the Allocation Rule creation form. Values must match keys in allocation_config.json.",

    "source_tables": [
        {"value": "proc_inst_data",     "label": "Instrument (proc_inst_data)"},
        {"value": "proc_gl_data",       "label": "General Ledger (proc_gl_data)"},
        {"value": "fct_mgmt_ledger",    "label": "Management Ledger (fct_mgmt_ledger)"},
        {"value": "fct_mgmt_instrument","label": "Management Instrument (fct_mgmt_instrument)"}
    ],

    "lookup_tables": [
        {"value": "ref_static_allocation",  "label": "Static Allocation (ref_static_allocation)"},
        {"value": "ref_org_reclass",         "label": "Org Reclassification (ref_org_reclass)"},
        {"value": "ref_static_distribution", "label": "Static Distribution (ref_static_distribution)"},
        {"value": "ref_static_alloc",        "label": "Static Alloc Mapping (ref_static_alloc)"}
    ],

    "output_tables": [
        {"value": "fct_mgmt_instrument", "label": "Management Instrument (fct_mgmt_instrument)"},
        {"value": "fct_mgmt_ledger",     "label": "Management Ledger (fct_mgmt_ledger)"}
    ],

    "join_keys": [
        {"value": "customer_id",        "label": "customer_id",        "available_in": ["proc_inst_data", "fct_mgmt_ledger", "fct_mgmt_instrument"]},
        {"value": "org_unit_id",        "label": "org_unit_id",        "available_in": ["proc_inst_data", "proc_gl_data"]},
        {"value": "source_org_unit_id", "label": "source_org_unit_id", "available_in": ["fct_mgmt_ledger", "fct_mgmt_instrument"]},
        {"value": "source_account_id",  "label": "source_account_id",  "available_in": ["fct_mgmt_ledger", "fct_mgmt_instrument"]},
        {"value": "product_code",       "label": "product_code",       "available_in": ["proc_inst_data", "fct_mgmt_ledger", "fct_mgmt_instrument"]},
        {"value": "account_id",         "label": "account_id",         "available_in": ["proc_inst_data"]},
        {"value": "gl_account",         "label": "gl_account",         "available_in": ["proc_gl_data"]}
    ],

    "defaults": {
        "source_table": "proc_inst_data",
        "lookup_table": "ref_static_allocation",
        "output_table": "fct_mgmt_instrument",
        "join_key": "customer_id"
    },

    "dimension_config": {
        "proc_inst_data": [
            {"column": "account_id",   "label": "Account ID"},
            {"column": "customer_id",  "label": "Customer ID"},
            {"column": "product_code", "label": "Product Code"},
            {"column": "org_unit_id",  "label": "Org Unit"}
        ],
        "proc_gl_data": [
            {"column": "gl_account",   "label": "GL Account"},
            {"column": "org_unit_id",  "label": "Org Unit"}
        ],
        "fct_mgmt_ledger": [
            {"column": "source_account_id",  "label": "Source Account ID"},
            {"column": "customer_id",        "label": "Customer ID"},
            {"column": "product_code",       "label": "Product Code"},
            {"column": "source_org_unit_id", "label": "Source Org Unit"},
            {"column": "target_org_unit_id", "label": "Target Org Unit"}
        ],
        "fct_mgmt_instrument": [
            {"column": "source_account_id",  "label": "Source Account ID"},
            {"column": "customer_id",        "label": "Customer ID"},
            {"column": "product_code",       "label": "Product Code"},
            {"column": "source_org_unit_id", "label": "Source Org Unit"},
            {"column": "target_org_unit_id", "label": "Target Org Unit"}
        ]
    },

    "balance_columns": {
        "proc_inst_data": [
            {"value": "balance",         "label": "Balance"},
            {"value": "interest_income", "label": "Interest Income"}
        ],
        "proc_gl_data": [
            {"value": "balance", "label": "Balance"},
            {"value": "debit",   "label": "Debit"},
            {"value": "credit",  "label": "Credit"}
        ],
        "fct_mgmt_ledger": [
            {"value": "allocated_balance", "label": "Allocated Balance"},
            {"value": "allocated_income",  "label": "Allocated Income"}
        ],
        "fct_mgmt_instrument": [
            {"value": "allocated_balance", "label": "Allocated Balance"},
            {"value": "allocated_income",  "label": "Allocated Income"}
        ]
    },

    "lookup_output_columns": {
        "ref_static_allocation": [
            {"column": "target_org_unit_id", "label": "Target Org Unit"},
            {"column": "customer_id",        "label": "Customer ID (lookup)"}
        ],
        "ref_org_reclass": [
            {"column": "target_org_unit_id", "label": "Target Org Unit"}
        ],
        "ref_static_distribution": [
            {"column": "target_dim", "label": "Target Dimension (target_dim)"}
        ],
        "ref_static_alloc": [
            {"column": "target_dim", "label": "Target Dimension (target_dim)"}
        ]
    },

    "allocation_methods": [
        {
            "value": "RATIO",
            "label": "Ratio-Based Allocation",
            "description": "Join source to a lookup table and allocate balance using ratios. Supports ref_static_allocation, ref_org_reclass."
        },
        {
            "value": "DISTRIBUTION",
            "label": "Static Distribution",
            "description": "Distribute source balance to flexible target dimensions using ref_static_distribution. Target dimension value is taken from the target_dim column."
        },
        {
            "value": "STATIC",
            "label": "Static Allocation",
            "description": "Direct pass-through allocation with ratio=1.0. No lookup table required. Ideal for instrument aggregation and simple reclassification."
        }
    ],

    "dim_modes": {
        "source": [
            {"value": "all",      "label": "All Members"},
            {"value": "specific", "label": "Specific Members"}
        ],
        "output": [
            {"value": "same_as_source", "label": "Same as Source"},
            {"value": "lookup",         "label": "From Lookup"},
            {"value": "fixed",          "label": "Fixed Value"}
        ]
    }
}
