{
    "description": "Drives the Allocation Rule creation form. Values must match keys in allocation_config.json.",

    "source_tables": [
        {"value": "proc_inst_data", "label": "Instrument (proc_inst_data)"},
        {"value": "proc_gl_data", "label": "General Ledger (proc_gl_data)"}
    ],

    "lookup_tables": [
        {"value": "ref_static_allocation", "label": "Static Allocation (ref_static_allocation)"},
        {"value": "ref_org_reclass", "label": "Org Reclassification (ref_org_reclass)"}
    ],

    "output_tables": [
        {"value": "fct_mgmt_instrument", "label": "Management Instrument (fct_mgmt_instrument)"},
        {"value": "fct_mgmt_ledger",     "label": "Management Ledger (fct_mgmt_ledger)"}
    ],

    "join_keys": [
        {"value": "customer_id", "label": "customer_id"},
        {"value": "org_unit_id", "label": "org_unit_id"},
        {"value": "product_code", "label": "product_code"}
    ],

    "defaults": {
        "source_table": "proc_inst_data",
        "lookup_table": "ref_static_allocation",
        "output_table": "fct_mgmt_instrument",
        "join_key": "customer_id"
    },

    "dimension_config": {
        "proc_inst_data": [
            {"column": "account_id",   "label": "Account ID"},
            {"column": "customer_id",  "label": "Customer ID"},
            {"column": "product_code", "label": "Product Code"},
            {"column": "org_unit_id",  "label": "Org Unit"}
        ],
        "proc_gl_data": [
            {"column": "gl_account",   "label": "GL Account"},
            {"column": "org_unit_id",  "label": "Org Unit"}
        ]
    },

    "lookup_output_columns": {
        "ref_static_allocation": [
            {"column": "target_org_unit_id", "label": "Target Org Unit"},
            {"column": "customer_id",        "label": "Customer ID (lookup)"}
        ],
        "ref_org_reclass": [
            {"column": "target_org_unit_id", "label": "Target Org Unit"}
        ]
    },

    "dim_modes": {
        "source": [
            {"value": "all",      "label": "All Members"},
            {"value": "specific", "label": "Specific Members"}
        ],
        "output": [
            {"value": "same_as_source", "label": "Same as Source"},
            {"value": "lookup",         "label": "From Lookup"},
            {"value": "fixed",          "label": "Fixed Value"}
        ]
    }
}
