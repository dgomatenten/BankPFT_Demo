{
    "allowed_extensions": ["xlsx", "csv"],

    "data_types": {
        "INSTRUMENT": {
            "label": "Instrument Data",
            "description": "Account-level financial instrument balances",
            "required_columns": ["as_of_date", "account_id", "customer_id", "product_code", "org_unit_id", "balance"],
            "optional_columns": ["interest_income"],
            "unique_key": "account_id",
            "staging_table": "stg_inst_data",
            "dimension_lookups": {
                "customer_id": "dim_customer",
                "product_code": "dim_product",
                "org_unit_id": "dim_org_unit"
            },
            "numeric_ranges": {
                "balance": {"min": null, "max": null},
                "interest_income": {"min": 0, "max": null}
            },
            "column_mapping": {
                "as_of_date": {"type": "date"},
                "account_id": {"type": "string"},
                "customer_id": {"type": "string"},
                "product_code": {"type": "string"},
                "org_unit_id": {"type": "string"},
                "balance": {"type": "float"},
                "interest_income": {"type": "float", "default": 0}
            },
            "validation_rules": ["required_columns", "null_check", "unique_key", "dimension_lookup", "numeric_range"]
        },
        "GL": {
            "label": "General Ledger",
            "description": "GL account balances by org unit",
            "required_columns": ["as_of_date", "gl_account", "org_unit_id", "balance"],
            "optional_columns": ["debit", "credit"],
            "unique_key": null,
            "staging_table": "stg_gl_data",
            "dimension_lookups": {
                "org_unit_id": "dim_org_unit"
            },
            "numeric_ranges": {
                "debit": {"min": 0, "max": null},
                "credit": {"min": 0, "max": null}
            },
            "column_mapping": {
                "as_of_date": {"type": "date"},
                "gl_account": {"type": "string"},
                "org_unit_id": {"type": "string"},
                "debit": {"type": "float", "default": 0},
                "credit": {"type": "float", "default": 0},
                "balance": {"type": "float"}
            },
            "validation_rules": ["required_columns", "null_check", "dimension_lookup", "numeric_range"]
        },
        "ALLOCATION": {
            "label": "Allocation Ratios",
            "description": "Static allocation ratios for customer shredding",
            "required_columns": ["allocation_id", "customer_id", "source_org_unit_id", "target_org_unit_id", "ratio"],
            "optional_columns": [],
            "unique_key": null,
            "staging_table": "ref_static_allocation",
            "dimension_lookups": {
                "customer_id": "dim_customer",
                "source_org_unit_id": "dim_org_unit",
                "target_org_unit_id": "dim_org_unit"
            },
            "ratio_validation": {
                "enabled": true,
                "group_by": ["allocation_id", "customer_id"],
                "sum_column": "ratio",
                "expected_sum": 1.0,
                "tolerance": 0.001
            },
            "numeric_ranges": {
                "ratio": {"min": 0, "max": 1}
            },
            "column_mapping": {
                "allocation_id": {"type": "string"},
                "customer_id": {"type": "string"},
                "source_org_unit_id": {"type": "string"},
                "target_org_unit_id": {"type": "string"},
                "ratio": {"type": "float"}
            },
            "validation_rules": ["required_columns", "null_check", "dimension_lookup", "ratio_sum", "numeric_range"]
        },
        "ORG_RECLASS": {
            "label": "Org Reclassification",
            "description": "Org unit reclassification mapping (1:1)",
            "required_columns": ["reclass_id", "source_org_unit_id", "target_org_unit_id"],
            "optional_columns": ["ratio"],
            "unique_key": null,
            "staging_table": "ref_org_reclass",
            "dimension_lookups": {
                "source_org_unit_id": "dim_org_unit",
                "target_org_unit_id": "dim_org_unit"
            },
            "numeric_ranges": {
                "ratio": {"min": 0, "max": 1}
            },
            "column_mapping": {
                "reclass_id": {"type": "string"},
                "source_org_unit_id": {"type": "string"},
                "target_org_unit_id": {"type": "string"},
                "ratio": {"type": "float", "default": 1.0}
            },
            "validation_rules": ["required_columns", "null_check", "dimension_lookup", "numeric_range"]
        }
    }
}
