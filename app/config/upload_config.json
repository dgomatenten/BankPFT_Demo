{
    "allowed_extensions": ["xlsx", "csv"],

    "data_types": {
        "INSTRUMENT": {
            "label": "Instrument Data",
            "description": "Account-level financial instrument balances",
            "required_columns": ["as_of_date", "account_id", "customer_id", "product_code", "org_unit_id", "balance"],
            "optional_columns": ["interest_income"],
            "unique_key": "account_id",
            "staging_table": "stg_inst_data",
            "dimension_lookups": {
                "customer_id": "dim_customer",
                "product_code": "dim_product",
                "org_unit_id": "dim_org_unit"
            },
            "numeric_ranges": {
                "balance": {"min": null, "max": null},
                "interest_income": {"min": 0, "max": null}
            },
            "column_mapping": {
                "as_of_date": {"type": "date"},
                "account_id": {"type": "string"},
                "customer_id": {"type": "string"},
                "product_code": {"type": "string"},
                "org_unit_id": {"type": "string"},
                "balance": {"type": "float"},
                "interest_income": {"type": "float", "default": 0}
            },
            "validation_rules": ["required_columns", "null_check", "unique_key", "dimension_lookup", "numeric_range"],
            "post_approval": {"type": "run_rules", "rule_ids": [], "description": "Allocation rule IDs to run automatically after instrument data is approved"}
        },
        "GL": {
            "label": "General Ledger",
            "description": "GL account balances by org unit",
            "required_columns": ["as_of_date", "gl_account", "org_unit_id", "balance"],
            "optional_columns": ["debit", "credit", "financial_element"],
            "unique_key": null,
            "staging_table": "stg_gl_data",
            "dimension_lookups": {
                "org_unit_id": "dim_org_unit"
            },
            "numeric_ranges": {
                "debit": {"min": 0, "max": null},
                "credit": {"min": 0, "max": null}
            },
            "column_mapping": {
                "as_of_date": {"type": "date"},
                "gl_account": {"type": "string"},
                "org_unit_id": {"type": "string"},
                "debit": {"type": "float", "default": 0},
                "credit": {"type": "float", "default": 0},
                "balance": {"type": "float"},
                "financial_element": {"type": "string", "default": null}
            },
            "validation_rules": ["required_columns", "null_check", "dimension_lookup", "numeric_range"],
            "post_approval": {"type": "run_rules", "rule_ids": [], "description": "Allocation rule IDs to run automatically after GL data is approved"}
        },
        "ALLOCATION": {
            "label": "Allocation Ratios",
            "description": "Static allocation ratios for customer shredding",
            "required_columns": ["allocation_id", "customer_id", "source_org_unit_id", "target_org_unit_id", "ratio", "as_of_date"],
            "optional_columns": [],
            "unique_key": null,
            "staging_table": "ref_static_allocation",
            "dimension_lookups": {
                "customer_id": "dim_customer",
                "source_org_unit_id": "dim_org_unit",
                "target_org_unit_id": "dim_org_unit"
            },
            "ratio_validation": {
                "enabled": true,
                "group_by": ["allocation_id", "customer_id"],
                "sum_column": "ratio",
                "expected_sum": 1.0,
                "tolerance": 0.001
            },
            "numeric_ranges": {
                "ratio": {"min": 0, "max": 1}
            },
            "column_mapping": {
                "allocation_id": {"type": "string"},
                "customer_id": {"type": "string"},
                "source_org_unit_id": {"type": "string"},
                "target_org_unit_id": {"type": "string"},
                "ratio": {"type": "float"},
                "as_of_date": {"type": "date"}
            },
            "validation_rules": ["required_columns", "null_check", "dimension_lookup", "ratio_sum", "numeric_range"],
            "post_approval": {"type": "stored_procedure", "procedure_name": "sp_refresh_allocation_cache"}
        },
        "ORG_RECLASS": {
            "label": "Org Reclassification",
            "description": "Org unit reclassification mapping (1:1)",
            "required_columns": ["reclass_id", "source_org_unit_id", "target_org_unit_id", "as_of_date"],
            "optional_columns": ["ratio"],
            "unique_key": null,
            "staging_table": "ref_org_reclass",
            "dimension_lookups": {
                "source_org_unit_id": "dim_org_unit",
                "target_org_unit_id": "dim_org_unit"
            },
            "numeric_ranges": {
                "ratio": {"min": 0, "max": 1}
            },
            "column_mapping": {
                "reclass_id": {"type": "string"},
                "source_org_unit_id": {"type": "string"},
                "target_org_unit_id": {"type": "string"},
                "ratio": {"type": "float", "default": 1.0},
                "as_of_date": {"type": "date"}
            },
            "validation_rules": ["required_columns", "null_check", "dimension_lookup", "numeric_range"],
            "post_approval": null
        },
        "INTEREST_RATE": {
            "label": "Interest Rate Curves",
            "description": "Daily interest rate curve data for FTP (effective_date, rate_code, tenor, rate)",
            "required_columns": ["effective_date", "interest_rate_code", "term", "term_mult", "rate"],
            "optional_columns": [],
            "unique_key": null,
            "staging_table": "ref_interest_rate",
            "numeric_ranges": {
                "term": {"min": 1, "max": null},
                "rate": {"min": -1, "max": 10}
            },
            "column_mapping": {
                "effective_date": {"type": "date"},
                "interest_rate_code": {"type": "string"},
                "term": {"type": "integer"},
                "term_mult": {"type": "string"},
                "rate": {"type": "float"}
            },
            "validation_rules": ["required_columns", "null_check", "numeric_range"],
            "post_approval": null
        },
        "DISTRIBUTION": {
            "label": "Static Distribution",
            "description": "Distribution table mapping source dimension values to target dimensions with ratios. Used by the Static Distribution allocation method. Required columns: driver_name, distribution_id, target_dim, ratio. Include one of customer_id / org_unit_id / product_code as the join key column.",
            "required_columns": ["driver_name", "distribution_id", "target_dim", "ratio", "as_of_date"],
            "optional_columns": ["customer_id", "org_unit_id", "product_code"],
            "unique_key": null,
            "staging_table": "ref_static_distribution",
            "ratio_validation": {
                "enabled": true,
                "group_by": ["driver_name", "distribution_id"],
                "sum_column": "ratio",
                "expected_sum": 1.0,
                "tolerance": 0.001
            },
            "numeric_ranges": {
                "ratio": {"min": 0, "max": 1}
            },
            "column_mapping": {
                "driver_name":     {"type": "string"},
                "distribution_id": {"type": "string"},
                "customer_id":     {"type": "string", "default": null},
                "org_unit_id":     {"type": "string", "default": null},
                "product_code":    {"type": "string", "default": null},
                "target_dim":      {"type": "string"},
                "ratio":           {"type": "float"},
                "as_of_date":      {"type": "date"}
            },
            "validation_rules": ["required_columns", "null_check", "ratio_sum", "numeric_range"],
            "post_approval": {"type": "stored_procedure", "procedure_name": "sp_refresh_distribution_cache"}
        },
        "STATIC_ALLOC": {
            "label": "Static Allocation Mapping",
            "description": "Simple source-to-target dimension mapping for Static Allocation (aggregation / reclass). Required columns: alloc_id, target_dim. Include one of customer_id / org_unit_id / product_code as the join key. Ratio defaults to 1.0.",
            "required_columns": ["alloc_id", "target_dim", "as_of_date"],
            "optional_columns": ["customer_id", "org_unit_id", "product_code", "ratio"],
            "unique_key": null,
            "staging_table": "ref_static_alloc",
            "numeric_ranges": {
                "ratio": {"min": 0, "max": 1}
            },
            "column_mapping": {
                "alloc_id":     {"type": "string"},
                "customer_id":  {"type": "string", "default": null},
                "org_unit_id":  {"type": "string", "default": null},
                "product_code": {"type": "string", "default": null},
                "target_dim":   {"type": "string"},
                "ratio":        {"type": "float", "default": 1.0},
                "as_of_date":   {"type": "date"}
            },
            "validation_rules": ["required_columns", "null_check", "numeric_range"],
            "post_approval": null
        }
    }
}
